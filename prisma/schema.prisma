// ============================================================================
// LAGES PROTEGE ANIMAIS — MODELO DE DADOS (PostgreSQL 16+)
// Prisma 6
//
// Regras estruturais aplicadas (§50, §100, §79):
//  - PK uuid(7) (ordenavel por tempo -> indice B-tree com baixa fragmentacao)
//  - FK explicitas com ON DELETE explicito (nunca CASCADE em dado de evidencia)
//  - soft delete (deletedAt) onde o registro tem valor historico/legal
//  - timestamps createdAt/updatedAt em toda entidade
//  - unique constraints onde ha semantica de unicidade
//  - indices por caminhos quentes: protocolo, status+prioridade, geo, createdAt
//  - NUNCA armazenar dado pessoal em coluna livre de texto publico
// ============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

