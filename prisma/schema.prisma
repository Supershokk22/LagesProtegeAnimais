model SecurityIncident {
  id                String         @id @default(uuid(7)) @db.Uuid
  title             String         @db.VarChar(200)
  description       String?        @db.Text
  severity          Int            @default(3) // 1 baixa .. 5 critica
  status            IncidentStatus @default(DETECTADO)
  detectedAt        DateTime       @default(now()) @map("detected_at") @db.Timestamptz(6)
  containedAt       DateTime?      @map("contained_at") @db.Timestamptz(6)
  resolvedAt        DateTime?      @map("resolved_at") @db.Timestamptz(6)
  rootCause         String?        @map("root_cause") @db.Text
  impact            String?        @db.Text
  actions           Json?
  // comunicacao ao titular / ANPD quando aplicavel
  notifiedAnpd      Boolean        @default(false) @map("notified_anpd")
  notifiedTitulares Int            @default(0) @map("notified_titulares")
  ownerId           String?        @map("owner_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([status, severity])
  @@index([detectedAt(sort: Desc)])
  @@map("security_incidents")
}

model RateLimitCounter {
