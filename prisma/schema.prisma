  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(6)

  verifiedBy User? @relation(fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([status, isEmergency])
  @@index([serviceType])
  @@map("official_contacts")
}

model SourceRegistry {
  id          String       @id @default(uuid(7)) @db.Uuid
  itemType    String       @map("item_type") @db.VarChar(60)
  itemId      String       @map("item_id") @db.Uuid
  sourceName  String       @map("source_name") @db.VarChar(200)
  sourceUrl   String       @map("source_url") @db.VarChar(800)
