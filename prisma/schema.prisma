model Ticket {
  id          String       @id @default(uuid(7)) @db.Uuid
  protocol    String       @unique @db.VarChar(24)
  subject     String       @db.VarChar(200)
  category    String       @db.VarChar(60)
  priority    Urgency      @default(MODERADA)
  status      TicketStatus @default(ABERTO)
  reportId    String?      @map("report_id") @db.Uuid
  assigneeId  String?      @map("assignee_id") @db.Uuid
  reporterId  String?      @map("reporter_id") @db.Uuid
  slaPolicyId String?      @map("sla_policy_id") @db.Uuid
  dueAt       DateTime?    @map("due_at") @db.Timestamptz(6)
  resolvedAt  DateTime?    @map("resolved_at") @db.Timestamptz(6)
  resolution  String?      @db.Text
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignee  User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter  User?           @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  report    Report?         @relation(fields: [reportId], references: [id], onDelete: SetNull)
  slaPolicy SlaPolicy?      @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
