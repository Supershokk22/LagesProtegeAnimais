  @@map("sla_policies")
}

// ============================================================================
// ANIMAIS (§21-§29)
// ============================================================================

model Animal {
  id             String          @id @default(uuid(7)) @db.Uuid
  name           String?         @db.VarChar(80)
  species        Species
  breed          String?         @db.VarChar(120)
  sex            Sex             @default(NAO_INFORMADO)
  ageMonths      Int?            @map("age_months")
  ageEstimate    String?         @map("age_estimate") @db.VarChar(40)
  size           AnimalSize?
  color          String?         @db.VarChar(120)
  temperament    String?         @db.Text
  weightKg       Float?          @map("weight_kg")
  isNeutered     Boolean         @default(false) @map("is_neutered")
  isVaccinated   Boolean         @default(false) @map("is_vaccinated")
  vaccineDetail  String?         @map("vaccine_detail") @db.VarChar(240)
  dewormed       Boolean         @default(false)
  specialNeeds   String?         @map("special_needs") @db.Text
  healthNotes    String?         @map("health_notes") @db.Text
  condition      AnimalCondition @default(SAUDAVEL)
  isMicrochipped Boolean         @default(false) @map("is_microchipped")

  status      AnimalAdoptionStatus @default(DISPONIVEL)
  intakeType  String?              @map("intake_type") @db.VarChar(60) // RESGATE | NASCIDO | DOACAO | TRANSFERENCIA
  intakeDate  DateTime?            @map("intake_date") @db.Date
  intakeNotes String?              @map("intake_notes") @db.Text

  organizationId  String?        @map("organization_id") @db.Uuid
  protectorId     String?        @map("protector_id") @db.Uuid
  locationId      String?        @map("location_id") @db.Uuid
  neighborhoodId  String?        @map("neighborhood_id") @db.Uuid
  // localizacao aproximada (endereco exato nunca publico)
  publicLat       Float?         @map("public_lat")
  publicLng       Float?         @map("public_lng")
  publicPrecision PrecisionLevel @default(AGREGADA) @map("public_precision")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  protector    Protector?         @relation(fields: [protectorId], references: [id], onDelete: SetNull)
  location     Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  neighborhood Neighborhood?      @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)
  images       AnimalImage[]
  adoptions    Adoption[]
  adoptionReqs AdoptionRequest[]
  followups    AdoptionFollowup[]
  reports      ReportAnimal[]
  fosterLinks  FosterLink[]
  posts        Post[]

  @@index([species, status])
  @@index([organizationId])
  @@index([protectorId])
  @@index([status, createdAt(sort: Desc)])
  @@index([publicLat, publicLng])
  @@index([neighborhoodId])
  @@map("animals")
}

model AnimalImage {
  id           String   @id @default(uuid(7)) @db.Uuid
  animalId     String   @map("animal_id") @db.Uuid
  attachmentId String   @map("attachment_id") @db.Uuid
  caption      String?  @db.VarChar(240)
  position     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  animal     Animal     @relation(fields: [animalId], references: [id], onDelete: Cascade)
  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Restrict)

  @@unique([animalId, position])
  @@map("animal_images")
}

model FosterLink {
  id           String    @id @default(uuid(7)) @db.Uuid
  animalId     String    @map("animal_id") @db.Uuid
  keeperUserId String    @map("keeper_user_id") @db.Uuid
  kind         String    @db.VarChar(40) // LAR_TEMPORARIO | LAR_SOLIDARIO | RESGATE
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt      DateTime? @map("ended_at") @db.Timestamptz(6)
  notes        String?   @db.Text
  capacity     Int       @default(1)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)
  keeper User   @relation(fields: [keeperUserId], references: [id], onDelete: Cascade)

  @@index([keeperUserId, active])
  @@index([animalId])
  @@map("foster_links")
}

model Adoption {
  id              String                @id @default(uuid(7)) @db.Uuid
  animalId        String                @map("animal_id") @db.Uuid
  adopterId       String                @map("adopter_id") @db.Uuid
  registeredById  String?               @map("registered_by") @db.Uuid
  organizationId  String?               @map("organization_id") @db.Uuid
  status          AdoptionRequestStatus @default(INTERESSE)
  adoptedAt       DateTime?             @map("adopted_at") @db.Timestamptz(6)
  followUpDueAt   DateTime?             @map("follow_up_due_at") @db.Timestamptz(6)
  termsAcceptedAt DateTime?             @map("terms_accepted_at") @db.Timestamptz(6)
  notes           String?               @db.Text
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  animal       Animal             @relation(fields: [animalId], references: [id], onDelete: Restrict)
  adopter      User               @relation(fields: [adopterId], references: [id], onDelete: Restrict)
  registeredBy User?              @relation("AdoptionRegistrant", fields: [registeredById], references: [id], onDelete: SetNull)
  organization Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  followups    AdoptionFollowup[]

  @@index([animalId])
  @@index([adopterId])
  @@index([status])
  @@index([adoptedAt])
  @@map("adoptions")
}

model AdoptionRequest {
  id                 String                @id @default(uuid(7)) @db.Uuid
  animalId           String                @map("animal_id") @db.Uuid
  requesterId        String                @map("requester_id") @db.Uuid
  status             AdoptionRequestStatus @default(INTERESSE)
  // respostas do formulario (§22) — sem criterios discriminatorios injustificados
  experience         String?               @db.Text
  residence          String?               @db.VarChar(120) // CASA_APARTAMENTO_SOLO_PROPRIO...
  housingSpace       String?               @map("housing_space") @db.VarChar(120)
  householdSize      Int?                  @map("household_size")
  hasOtherAnimals    Boolean               @default(false) @map("has_other_animals")
  otherAnimalsDetail String?               @map("other_animals_detail") @db.Text
  hasYard            Boolean?              @map("has_yard")
  workSchedule       String?               @map("work_schedule") @db.VarChar(160)
  dailyPresence      String?               @map("daily_presence") @db.VarChar(120)
  vetAccess          Boolean?              @map("vet_access")
  motivation         String?               @db.Text
  guardianAgreement  Boolean               @default(false) @map("guardian_agreement")
  vetReference       String?               @map("vet_reference") @db.VarChar(200)
  decisionReason     String?               @map("decision_reason") @db.Text
  decidedById        String?               @map("decided_by") @db.Uuid
  decidedAt          DateTime?             @map("decided_at") @db.Timestamptz(6)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  animal    Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)
  requester User   @relation("AdoptionRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([animalId, status])
  @@index([requesterId])
  @@map("adoption_requests")
}

model AdoptionFollowup {
  id               String    @id @default(uuid(7)) @db.Uuid
  adoptionId       String    @map("adoption_id") @db.Uuid
  animalId         String    @map("animal_id") @db.Uuid
  milestoneDay     Int       @map("milestone_day") // 7 | 30 | 90 | 180
  dueAt            DateTime  @map("due_at") @db.Timestamptz(6)
  doneAt           DateTime? @map("done_at") @db.Timestamptz(6)
  contactMethod    String?   @map("contact_method") @db.VarChar(60)
  outcome          String?   @db.Text
  problemsReported String?   @map("problems_reported") @db.Text
  supportProvided  String?   @map("support_provided") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  adoption Adoption @relation(fields: [adoptionId], references: [id], onDelete: Cascade)
  animal   Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@unique([adoptionId, milestoneDay])
  @@index([dueAt, doneAt])
  @@map("adoption_followups")
}

model LostAnimal {
  id               String          @id @default(uuid(7)) @db.Uuid
  animalName       String          @map("animal_name") @db.VarChar(80)
  species          Species
  breed            String?         @db.VarChar(120)
  sex              Sex             @default(NAO_INFORMADO)
  color            String?         @db.VarChar(160)
  size             AnimalSize?
  distinguishing   String?         @db.Text
  microchip        String?         @db.VarChar(40)
  collar           Boolean         @default(false)
  vaccinationCard  Boolean         @default(false) @map("vaccination_card")
  lastSeenAt       DateTime?       @map("last_seen_at") @db.Timestamptz(6)
  lastSeenPlace    String?         @map("last_seen_place") @db.VarChar(240)
  neighborhoodId   String?         @map("neighborhood_id") @db.Uuid
  lat              Float?
  lng              Float?
  publicLat        Float?          @map("public_lat")
  publicLng        Float?          @map("public_lng")
  publicPrecision  PrecisionLevel  @default(APROXIMADA) @map("public_precision")
  rewardInfo       String?         @map("reward_info") @db.VarChar(120)
  status           LostFoundStatus @default(ATIVO)
  ownerId          String          @map("owner_id") @db.Uuid
  // contato MEDIADO (§24): telefone/email nunca exposto publicamente
  contactVisible   Boolean         @default(false) @map("contact_visible")
  resolvedAt       DateTime?       @map("resolved_at") @db.Timestamptz(6)
  resolvedAnimalId String?         @map("resolved_animal_id") @db.Uuid
  attachmentId     String?         @map("attachment_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?       @map("deleted_at") @db.Timestamptz(6)

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  neighborhood Neighborhood? @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)
  attachment   Attachment?   @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  matches      AnimalMatch[] @relation("LostMatches")

  @@index([status, createdAt(sort: Desc)])
  @@index([species, status])
  @@index([neighborhoodId])
  @@map("lost_animals")
}

model FoundAnimal {
  id               String          @id @default(uuid(7)) @db.Uuid
  species          Species
  breed            String?         @db.VarChar(120)
  sex              Sex             @default(NAO_INFORMADO)
  color            String?         @db.VarChar(160)
  size             AnimalSize?
  distinguishing   String?         @db.Text
  foundAt          DateTime?       @map("found_at") @db.Timestamptz(6)
  foundPlace       String          @map("found_place") @db.VarChar(240)
  neighborhoodId   String?         @map("neighborhood_id") @db.Uuid
  lat              Float?
  lng              Float?
  publicLat        Float?          @map("public_lat")
  publicLng        Float?          @map("public_lng")
  publicPrecision  PrecisionLevel  @default(APROXIMADA) @map("public_precision")
  healthState      String?         @map("health_state") @db.VarChar(120)
  isInjured        Boolean         @default(false) @map("is_injured")
  hasChip          Boolean         @default(false) @map("has_chip")
  chipNumber       String?         @map("chip_number") @db.VarChar(40)
  heldAtLocationId String?         @map("held_at_location_id") @db.Uuid
  status           LostFoundStatus @default(ATIVO)
  finderId         String?         @map("finder_id") @db.Uuid
  contactVisible   Boolean         @default(true) @map("contact_visible")
  resolvedAt       DateTime?       @map("resolved_at") @db.Timestamptz(6)
  resolvedAnimalId String?         @map("resolved_animal_id") @db.Uuid
  attachmentId     String?         @map("attachment_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?       @map("deleted_at") @db.Timestamptz(6)

  finder       User?         @relation(fields: [finderId], references: [id], onDelete: SetNull)
  neighborhood Neighborhood? @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)
  attachment   Attachment?   @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  heldAt       Location?     @relation(fields: [heldAtLocationId], references: [id], onDelete: SetNull)
  matches      AnimalMatch[] @relation("FoundMatches")

  @@index([status, createdAt(sort: Desc)])
  @@index([species, status])
  @@index([neighborhoodId])
  @@map("found_animals")
}

enum LostFoundStatus {
  ATIVO
  EM_CONTATO
  RESOLVIDO
  ENCERRADO
  SEM_SINAL
}

// ============================================================================
// MATCHING perdido x encontrado (§26)
// NAO afirma automaticamente que e o mesmo animal — apenas "possivel correspondencia"
// ============================================================================

model AnimalMatch {
  id            String      @id @default(uuid(7)) @db.Uuid
  lostAnimalId  String      @map("lost_animal_id") @db.Uuid
  foundAnimalId String      @map("found_animal_id") @db.Uuid
  score         Float       @default(0)
  factors       Json
  status        MatchStatus @default(SUGERIDO)
  reviewedById  String?     @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime?   @map("reviewed_at") @db.Timestamptz(6)
  notes         String?     @db.Text
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  lostAnimal  LostAnimal  @relation("LostMatches", fields: [lostAnimalId], references: [id], onDelete: Cascade)
  foundAnimal FoundAnimal @relation("FoundMatches", fields: [foundAnimalId], references: [id], onDelete: Cascade)

  @@unique([lostAnimalId, foundAnimalId])
  @@index([status, score(sort: Desc)])
  @@map("animal_matches")
}

// ============================================================================
// ORGANIZACOES / PROTETORES / VETERINARIOS (§27-§29)
// ============================================================================

model Organization {
  id                 String             @id @default(uuid(7)) @db.Uuid
  kind               OrgKind
  legalName          String             @map("legal_name") @db.VarChar(200)
  publicName         String             @map("public_name") @db.VarChar(160)
  cnpj               String?            @db.VarChar(18)
  responsibleName    String?            @map("responsible_name") @db.VarChar(160)
  // documento de verificacao
  verificationStatus VerificationStatus @default(NAO_VERIFICADO) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz(6)
  verifiedById       String?            @map("verified_by") @db.Uuid
  verificationDocUrl String?            @map("verification_doc_url") @db.VarChar(600)
  rejectionReason    String?            @map("rejection_reason") @db.Text

  description      String?  @db.Text
  serviceAreas     String[] @default([]) @map("service_areas")
  addressLine      String?  @map("address_line") @db.VarChar(240)
  neighborhoodId   String?  @map("neighborhood_id") @db.Uuid
  locationId       String?  @map("location_id") @db.Uuid
  publicLat        Float?   @map("public_lat")
  publicLng        Float?   @map("public_lng")
  phone            String?  @db.VarChar(20)
  whatsapp         String?  @db.VarChar(20)
  email            String?  @db.Citext
  website          String?  @db.VarChar(300)
  socialLinks      Json?    @map("social_links")
  openingHours     String?  @map("opening_hours") @db.VarChar(240)
  acceptsDonations Boolean  @default(false) @map("accepts_donations")
  active           Boolean  @default(true)
  isPublic         Boolean  @default(true) @map("is_public")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  location     Location?              @relation(fields: [locationId], references: [id], onDelete: SetNull)
  neighborhood Neighborhood?          @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)
  members      OrganizationMember[]
  animals      Animal[]
  adoptions    Adoption[]
  clinics      Clinic[]
  events       Event[]
  volunteers   VolunteerOpportunity[]
  attachments  Attachment[]
  verifiedBy   User?                  @relation("OrgVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  posts        Post[]
  campaigns    Campaign[]

  @@index([kind, verificationStatus])
  @@index([isPublic, active])
  @@index([neighborhoodId])
  @@map("organizations")
}

enum OrgKind {
  ONG
  PROTETOR_INDEPENDENTE
  CASTOR
  CLINICA
  HOSPITAL_VETERINARIO
  UNIVERSIDADE
  EMPRESA_APOIADORA
  ORGAO_PUBLICO
  ESCOLA
  OUTRO
}

model OrganizationMember {
