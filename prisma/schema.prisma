  isManager      Boolean   @default(false) @map("is_manager")
  joinedAt       DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt         DateTime? @map("left_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, orgRole])
  @@index([userId])
  @@map("organization_members")
}

model Protector {
  id              String          @id @default(uuid(7)) @db.Uuid
  userId          String          @unique @map("user_id") @db.Uuid
  status          ProtectorStatus @default(NAO_VERIFICADO)
  verifiedAt      DateTime?       @map("verified_at") @db.Timestamptz(6)
  verifiedById    String?         @map("verified_by") @db.Uuid
  docType         String?         @map("doc_type") @db.VarChar(80)
  docNumber       String?         @map("doc_number") @db.VarChar(60)
  capacity        Int             @default(0) // quantos animais aceita acolher
  rescuedCount    Int             @default(0) @map("rescued_count")
  rejectionReason String?         @map("rejection_reason") @db.Text
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy User?    @relation("ProtectorVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  animals    Animal[]

  @@index([status])
  @@map("protectors")
}

model Veterinarian {
  id                 String             @id @default(uuid(7)) @db.Uuid
  userId             String?            @unique @map("user_id") @db.Uuid
  name               String             @db.VarChar(160)
  croCrv             String?            @map("cro_crv") @db.VarChar(40)
  specialties        String[]           @default([])
  clinicId           String?            @map("clinic_id") @db.Uuid
  email              String?            @db.Citext
  phone              String?            @db.VarChar(20)
  verificationStatus VerificationStatus @default(NAO_VERIFICADO) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz(6)
  active             Boolean            @default(true)
  isPublic           Boolean            @default(true) @map("is_public")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  @@index([verificationStatus])
  @@map("veterinarians")
}

model Clinic {
  id                 String             @id @default(uuid(7)) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  name               String             @db.VarChar(160)
  cnpj               String?            @db.VarChar(18)
  crv                String?            @db.VarChar(40)
  specialties        String[]           @default([])
  emergency24h       Boolean            @default(false) @map("emergency_24h")
  acceptsRescue      Boolean            @default(false) @map("accepts_rescue")
  locationId         String?            @map("location_id") @db.Uuid
  publicLat          Float?             @map("public_lat")
  publicLng          Float?             @map("public_lng")
  phone              String?            @db.VarChar(20)
  whatsapp           String?            @db.VarChar(20)
  email              String?            @db.Citext
  website            String?            @db.VarChar(300)
  openingHours       String?            @map("opening_hours") @db.VarChar(240)
  verificationStatus VerificationStatus @default(NAO_VERIFICADO) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz(6)
  isPublic           Boolean            @default(true) @map("is_public")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?          @map("deleted_at") @db.Timestamptz(6)

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location      Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  veterinarians Veterinarian[]
  appointments  VetAppointment[]

  @@index([isPublic])
  @@index([emergency24h])
  @@map("clinics")
}

model VetAppointment {
  id          String   @id @default(uuid(7)) @db.Uuid
  clinicId    String   @map("clinic_id") @db.Uuid
  animalId    String?  @map("animal_id") @db.Uuid
  reportId    String?  @map("report_id") @db.Uuid
  scheduledAt DateTime @map("scheduled_at") @db.Timestamptz(6)
  service     String   @db.VarChar(120)
  status      String   @default("AGENDADO") @db.VarChar(30)
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, scheduledAt])
  @@map("vet_appointments")
}

// ============================================================================
// COMUNIDADE / REDE SOCIAL (§18-§20)
// ============================================================================

model Community {
  id              String        @id @default(uuid(7)) @db.Uuid
  kind            CommunityKind
  slug            String        @unique @db.VarChar(80)
  name            String        @db.VarChar(120)
  description     String?       @db.Text
  rules           String[]      @default([])
  coverUrl        String?       @map("cover_url") @db.VarChar(500)
  isPublic        Boolean       @default(true) @map("is_public")
  requireApproval Boolean       @default(false) @map("require_approval")
  memberCount     Int           @default(0) @map("member_count")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  members CommunityMember[]
  posts   Post[]
  events  Event[]
  follows Follow[]

  @@index([kind])
  @@map("communities")
}

model CommunityMember {
  id          String    @id @default(uuid(7)) @db.Uuid
  communityId String    @map("community_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  role        String    @default("MEMBER") @db.VarChar(30) // ADMIN | MODERATOR | MEMBER
  approvedAt  DateTime? @map("approved_at") @db.Timestamptz(6)
  joinedAt    DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt      DateTime? @map("left_at") @db.Timestamptz(6)
  mutedUntil  DateTime? @map("muted_until") @db.Timestamptz(6)

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
  @@map("community_members")
}

model Post {
  id             String     @id @default(uuid(7)) @db.Uuid
  authorId       String     @map("author_id") @db.Uuid
  communityId    String?    @map("community_id") @db.Uuid
  body           String     @db.Text
  // audiencia (§100): PUBLICO muda para COMUNIDADE
  visibility     Visibility @default(PUBLICO)
  isPinned       Boolean    @default(false) @map("is_pinned")
  isHidden       Boolean    @default(false) @map("is_hidden")
  hiddenReason   String?    @map("hidden_reason") @db.Text
  // entidades referenciadas (enriquecimento e busca)
  animalId       String?    @map("animal_id") @db.Uuid
  reportId       String?    @map("report_id") @db.Uuid
  campaignId     String?    @map("campaign_id") @db.Uuid
  organizationId String?    @map("organization_id") @db.Uuid
  likeCount      Int        @default(0) @map("like_count")
  commentCount   Int        @default(0) @map("comment_count")
  shareCount     Int        @default(0) @map("share_count")
  publishedAt    DateTime   @default(now()) @map("published_at") @db.Timestamptz(6)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?  @map("deleted_at") @db.Timestamptz(6)

  author         User            @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  community      Community?      @relation(fields: [communityId], references: [id], onDelete: SetNull)
  campaign       Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  animal         Animal?         @relation(fields: [animalId], references: [id], onDelete: SetNull)
  report         Report?         @relation(fields: [reportId], references: [id], onDelete: SetNull)
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  comments       Comment[]
  reactions      Reaction[]
  attachments    Attachment[]
  contentReports ContentReport[]
  follows        Follow[]        @relation("PostFollowers")

  @@index([communityId, publishedAt(sort: Desc)])
  @@index([authorId])
  @@index([visibility, isHidden, publishedAt(sort: Desc)])
  @@map("posts")
}

enum Visibility {
  PUBLICO
  COMUNIDADE
  APENAS_EQUIPE
}

model Comment {
  id           String    @id @default(uuid(7)) @db.Uuid
  postId       String    @map("post_id") @db.Uuid
  reportId     String?   @map("report_id") @db.Uuid
  authorId     String    @map("author_id") @db.Uuid
  parentId     String?   @map("parent_id") @db.Uuid
  body         String    @db.Text
  isInternal   Boolean   @default(false) @map("is_internal")
  isHidden     Boolean   @default(false) @map("is_hidden")
  hiddenReason String?   @map("hidden_reason") @db.Text
  likeCount    Int       @default(0) @map("like_count")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  post           Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  report         Report?         @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author         User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent         Comment?        @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies        Comment[]       @relation("CommentThread")
  reactions      Reaction[]
  contentReports ContentReport[]
  attachments    Attachment[]

  @@index([postId, createdAt])
  @@index([authorId])
  @@map("comments")
}

model Reaction {
  id        String   @id @default(uuid(7)) @db.Uuid
  kind      String   @db.VarChar(30) // LIKE | APOIO | CUIDADO | AJUDA
  postId    String?  @map("post_id") @db.Uuid
  commentId String?  @map("comment_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([kind, postId, userId])
  @@unique([kind, commentId, userId])
  @@index([userId])
  @@map("reactions")
}

model Follow {
  id          String   @id @default(uuid(7)) @db.Uuid
  followerId  String   @map("follower_id") @db.Uuid
  followeeId  String?  @map("followee_id") @db.Uuid
  postId      String?  @map("post_id") @db.Uuid
  communityId String?  @map("community_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  follower  User       @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee  User?      @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)
  post      Post?      @relation("PostFollowers", fields: [postId], references: [id], onDelete: Cascade)
  community Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@unique([followerId, postId])
  @@unique([followerId, communityId])
  @@index([followeeId])
  @@map("follows")
}

model DirectMessage {
  id          String    @id @default(uuid(7)) @db.Uuid
  senderId    String    @map("sender_id") @db.Uuid
  receiverId  String    @map("receiver_id") @db.Uuid
  // contexto mediado: dono do perdido <--> quem encontrou
  contextType String?   @map("context_type") @db.VarChar(40)
  contextId   String?   @map("context_id") @db.Uuid
  body        String    @db.Text
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  reported    Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  sender   User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId, readAt])
  @@index([senderId, receiverId])
  @@map("direct_messages")
}

// ============================================================================
// MODERACAO (§20)
// ============================================================================

model ContentReport {
  id             String             @id @default(uuid(7)) @db.Uuid
  reporterId     String             @map("reporter_id") @db.Uuid
  targetType     ContentType        @map("target_type")
  // FK separada por tipo: uma coluna so, mas com CHECK
  // (post_id IS NOT NULL OR comment_id IS NOT NULL OR profile_id IS NOT NULL)
  targetId       String             @map("target_id") @db.Uuid
  postId         String?            @map("post_id") @db.Uuid
  commentId      String?            @map("comment_id") @db.Uuid
  reason         String             @db.VarChar(80)
  details        String?            @db.Text
  status         ModerationDecision @default(PENDENTE)
  priority       Int                @default(0)
  assignedToId   String?            @map("assigned_to") @db.Uuid
  decidedById    String?            @map("decided_by") @db.Uuid
  decidedAt      DateTime?          @map("decided_at") @db.Timestamptz(6)
  decisionReason String?            @map("decision_reason") @db.Text
  appealOfId     String?            @map("appeal_of") @db.Uuid
  appealed       Boolean            @default(false)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  reporter  User            @relation("ContentReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  decidedBy User?           @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  post      Post?           @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   Comment?        @relation(fields: [commentId], references: [id], onDelete: Cascade)
  appealOf  ContentReport?  @relation("AppealChain", fields: [appealOfId], references: [id], onDelete: SetNull)
  appeals   ContentReport[] @relation("AppealChain")

  @@index([status, priority(sort: Desc)])
  @@index([targetType, targetId])
  @@index([reporterId])
  @@map("content_reports")
}

model ModerationAction {
  id              String      @id @default(uuid(7)) @db.Uuid
  actorId         String      @map("actor_id") @db.Uuid
  action          String      @db.VarChar(60)
  targetType      ContentType @map("target_type")
  targetId        String      @map("target_id") @db.Uuid
  reason          String      @db.Text
  ruleRef         String?     @map("rule_ref") @db.VarChar(80)
  contentSnapshot String?     @map("content_snapshot") @db.Text
  beforeHash      String?     @map("before_hash") @db.VarChar(64)
  afterHash       String?     @map("after_hash") @db.VarChar(64)
  auto            Boolean     @default(false)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User @relation("ModerationActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([targetType, targetId])
  @@index([actorId, createdAt(sort: Desc)])
  @@map("moderation_actions")
}

// ============================================================================
// ANEXOS / EVIDENCIAS (§10, §44)
// ============================================================================

model Attachment {
  id                String         @id @default(uuid(7)) @db.Uuid
  uploaderId        String?        @map("uploader_id") @db.Uuid
  // nome FINAL gerado pelo servidor (§44): jamais o nome enviado pelo cliente
  storageKey        String         @unique @map("storage_key") @db.VarChar(300)
  originalName      String?        @map("original_name") @db.VarChar(300)
  mimeType          String         @map("mime_type") @db.VarChar(120)
  kind              AttachmentKind
  extension         String         @db.VarChar(12)
  sizeBytes         Int            @map("size_bytes")
  sha256            String         @db.VarChar(64)
  sha512            String?        @db.VarChar(128)
  // magic bytes conferidos no upload (§44)
  magicVerified     Boolean        @default(false) @map("magic_verified")
  malwareScanStatus String         @default("PENDENTE") @map("malware_scan_status") @db.VarChar(30)
  width             Int?
  height            Int?
  durationSec       Int?           @map("duration_sec")
  caption           String?        @db.VarChar(400)
  // localizacao do storage: NONE = fora do diretorio publico
  storageDriver     String         @default("PRIVATE") @map("storage_driver") @db.VarChar(20)
  publicUrl         String?        @map("public_url") @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  uploader        User?                          @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  reportEvidence  ReportEvidence[]
  reports         Report[]
  posts           Post[]
  comments        Comment[]
  animalImages    AnimalImage[]
  organizations   Organization[]
  lostAnimals     LostAnimal[]
  foundAnimals    FoundAnimal[]
  restrictionDocs RestrictedGuardianshipRecord[]

  @@index([uploaderId])
  @@index([sha256])
  @@index([kind])
  @@map("attachments")
}

model ReportEvidence {
  id                 String              @id @default(uuid(7)) @db.Uuid
  reportId           String              @map("report_id") @db.Uuid
  attachmentId       String              @map("attachment_id") @db.Uuid
  accessLevel        EvidenceAccessLevel @default(RESTRITO)
  description        String?             @db.Text
  chainOfCustodyNote String?             @map("chain_of_custody_note") @db.Text
  // hash congelado no momento da vinculacao — divergencia = violacao
  hashAtLink         String              @map("hash_at_link") @db.VarChar(64)
  viewCount          Int                 @default(0) @map("view_count")
  lastViewedAt       DateTime?           @map("last_viewed_at") @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz(6)

  report     Report     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Restrict)

  @@unique([reportId, attachmentId])
  @@index([reportId, accessLevel])
  @@map("report_evidence")
}

// ============================================================================
// CAMPANHAS / EVENTOS / VOLUNTARIADO (§30-§32)
// ============================================================================

model Campaign {
  id                String         @id @default(uuid(7)) @db.Uuid
  slug              String         @unique @db.VarChar(120)
  title             String         @db.VarChar(200)
  summary           String?        @db.Text
  description       String         @db.Text
  kind              String         @db.VarChar(60) // CASTRACAO | VACINACAO | ADOCAO | ALIMENTACAO | ARRECADACAO | CONSCIENTIZACAO
  status            CampaignStatus @default(PLANEJADA)
  organizationId    String?        @map("organization_id") @db.Uuid
  responsibleName   String?        @map("responsible_name") @db.VarChar(160)
  startsAt          DateTime?      @map("starts_at") @db.Date
  endsAt            DateTime?      @map("ends_at") @db.Date
  goalCount         Int?           @map("goal_count")
  achievedCount     Int            @default(0) @map("achieved_count")
  goalAmountCents   BigInt?        @map("goal_amount_cents")
  raisedAmountCents BigInt         @default(0) @map("raised_amount_cents") // BigInt: nao usar float p/ dinheiro
  spentAmountCents  BigInt         @default(0) @map("spent_amount_cents")
  locationId        String?        @map("location_id") @db.Uuid
  resultsSummary    String?        @map("results_summary") @db.Text
  coverUrl          String?        @map("cover_url") @db.VarChar(500)
  isPublic          Boolean        @default(true) @map("is_public")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz(6)

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  location     Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  updates      CampaignUpdate[]
  events       Event[]
  posts        Post[]

  @@index([status, startsAt])
  @@index([organizationId])
  @@map("campaigns")
}

model CampaignUpdate {
  id          String   @id @default(uuid(7)) @db.Uuid
  campaignId  String   @map("campaign_id") @db.Uuid
  title       String   @db.VarChar(200)
  body        String   @db.Text
  metrics     Json?
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  createdById String   @map("created_by") @db.Uuid

  campaign  Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([campaignId, publishedAt(sort: Desc)])
  @@map("campaign_updates")
}

model Event {
  id               String      @id @default(uuid(7)) @db.Uuid
  title            String      @db.VarChar(200)
  description      String?     @db.Text
  kind             String      @db.VarChar(60)
  status           EventStatus @default(PLANEJADO)
  organizerName    String      @map("organizer_name") @db.VarChar(160)
  organizationId   String?     @map("organization_id") @db.Uuid
  communityId      String?     @map("community_id") @db.Uuid
  campaignId       String?     @map("campaign_id") @db.Uuid
  locationId       String?     @map("location_id") @db.Uuid
  publicLat        Float?      @map("public_lat")
  publicLng        Float?      @map("public_lng")
  startsAt         DateTime    @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime?   @map("ends_at") @db.Timestamptz(6)
  capacity         Int?
  registeredCount  Int         @default(0) @map("registered_count")
  requiresApproval Boolean     @default(false) @map("requires_approval")
  coverUrl         String?     @map("cover_url") @db.VarChar(500)
  isPublic         Boolean     @default(true) @map("is_public")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?   @map("deleted_at") @db.Timestamptz(6)

  organization  Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  community     Community?          @relation(fields: [communityId], references: [id], onDelete: SetNull)
  campaign      Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  location      Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  registrations EventRegistration[]

  @@index([startsAt])
  @@index([status])
  @@index([organizationId])
  @@map("events")
}

model EventRegistration {
  id          String    @id @default(uuid(7)) @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  status      String    @default("CONFIRMADO") @db.VarChar(30)
  attendees   Int       @default(1)
  notes       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_registrations")
}

model VolunteerOpportunity {
  id               String         @id @default(uuid(7)) @db.Uuid
  title            String         @db.VarChar(200)
  description      String?        @db.Text
  skill            VolunteerSkill
  // §30: atividade de risco restrita a equipes capacitadas
  riskLevel        Int            @default(1) @map("risk_level") // 1..3, 3 exige capacitacao
  requiresTraining Boolean        @default(false) @map("requires_training")
  organizationId   String?        @map("organization_id") @db.Uuid
  neighborhoodId   String?        @map("neighborhood_id") @db.Uuid
  slots            Int            @default(1)
  filledSlots      Int            @default(0) @map("filled_slots")
  startsAt         DateTime?      @map("starts_at") @db.Timestamptz(6)
  isRemote         Boolean        @default(false) @map("is_remote")
  isPublic         Boolean        @default(true) @map("is_public")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz(6)

