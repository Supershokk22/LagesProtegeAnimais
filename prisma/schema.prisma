  @@index([isPublic])
  @@map("volunteer_opportunities")
}

model VolunteerProfile {
  id             String           @id @default(uuid(7)) @db.Uuid
  userId         String           @unique @map("user_id") @db.Uuid
  skills         VolunteerSkill[] @default([])
  trainingDone   String[]         @default([]) @map("training_done")
  certifiedUntil DateTime?        @map("certified_until") @db.Date
  availableHours String[]         @default([]) @map("available_hours")
  transport      Boolean          @default(false)
  notes          String?          @db.Text
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications VolunteerApplication[]

  @@map("volunteer_profiles")
}

model VolunteerApplication {
  id                 String    @id @default(uuid(7)) @db.Uuid
  opportunityId      String    @map("opportunity_id") @db.Uuid
  volunteerId        String    @map("volunteer_id") @db.Uuid
  volunteerProfileId String?   @map("volunteer_profile_id") @db.Uuid
  status             String    @default("PENDENTE") @db.VarChar(30)
  motivation         String?   @db.Text
  decidedById        String?   @map("decided_by") @db.Uuid
  decidedAt          DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionNote       String?   @map("decision_note") @db.Text
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  opportunity      VolunteerOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  volunteer        User                 @relation("VolunteerApplicant", fields: [volunteerId], references: [id], onDelete: Cascade)
  volunteerProfile VolunteerProfile?    @relation(fields: [volunteerProfileId], references: [id], onDelete: SetNull)
  decidedBy        User?                @relation("VolunteerAppDecider", fields: [decidedById], references: [id], onDelete: SetNull)

