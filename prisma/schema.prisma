  organizationName String       @map("organization_name") @db.VarChar(200)
  department       String?      @db.VarChar(200)
  serviceType      String       @map("service_type") @db.VarChar(120)
  phone            String?      @db.VarChar(20)
  whatsapp         String?      @db.VarChar(20)
  email            String?      @db.Citext
  website          String?      @db.VarChar(400)
  address          String?      @db.VarChar(300)
  openingHours     String?      @map("opening_hours") @db.VarChar(240)
  municipality     String       @default("Lages") @db.VarChar(80)
  state            String       @default("SC") @db.VarChar(2)
  // §14: NUNCA inventar telefone/endereco. Sem source_url => status PENDENTE.
