// ============================================================================
// IDENTIDADE / AUTENTICACAO / RBAC
// ============================================================================

model User {
  id                String        @id @default(uuid(7)) @db.Uuid
  email             String        @unique @db.Citext
  emailAlt          String?       @map("email_alt") @db.Citext
  passwordHash      String?       @map("password_hash")
  status            UserStatus    @default(ACTIVE)
  // Identificacao publica (nao expor email/usuario em listagens publicas)
  publicName        String        @map("public_name") @db.VarChar(80)
  displayName       String?       @map("display_name") @db.VarChar(120)
  city              String?       @db.VarChar(120)
  neighborhoodId    String?       @map("neighborhood_id") @db.Uuid
  neighborhood      Neighborhood? @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)
  phone             String?       @db.VarChar(20)
  birthDate         DateTime?     @map("birth_date") @db.Date
  avatarUrl         String?       @map("avatar_url") @db.VarChar(500)
  coverUrl          String?       @map("cover_url") @db.VarChar(500)
  bio               String?       @db.Text
  isAnonymousPublic Boolean       @default(true) @map("is_anonymous_public")

  // 2FA (§16)
  twoFactorEnabled          Boolean @default(false) @map("two_factor_enabled")
  twoFactorSecretEnc        String? @map("two_factor_secret_enc") @db.Text
  twoFactorPendingSecretEnc String? @map("two_factor_pending_secret_enc") @db.Text

  // Seguranca
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(6)
  lastLoginIp         String?   @map("last_login_ip") @db.Inet
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamptz(6)
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  suspiciousLoginAt   DateTime? @map("suspicious_login_at") @db.Timestamptz(6)

  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  profile                              Profile?
  sessions                             Session[]
  roles                                UserRole[]
  consents                             ConsentRecord[]
  reports                              Report[]                       @relation("ReportAuthor")
  notifications                        Notification[]
  auditLogs                            AuditLog[]                     @relation("AuditActor")
  moderationActs                       ModerationAction[]             @relation("ModerationActor")
  privacyReqs                          PrivacyRequest[]               @relation("PrivacyRequester")
  privacyHandled                       PrivacyRequest[]               @relation("PrivacyHandler")
  adoptionReqs                         AdoptionRequest[]              @relation("AdoptionRequester")
  assignments                          ReportAssignment[]             @relation("AssignmentOperator")
  posts                                Post[]                         @relation("PostAuthor")
  comments                             Comment[]
  reactions                            Reaction[]
  contentReports                       ContentReport[]                @relation("ContentReporter")
  attachments                          Attachment[]
  tickets                              Ticket[]                       @relation("TicketAssignee")
  ticketsRaised                        Ticket[]
  ticketMessages                       TicketMessage[]
  events                               EventRegistration[]
  volunteerProfile                     VolunteerProfile?
  volunteerApplications                VolunteerApplication[]         @relation("VolunteerApplicant")
  fosterLinks                          FosterLink[]
  adoptions                            Adoption[]
  organizationMemberships              OrganizationMember[]
  communityMemberships                 CommunityMember[]
  veterinarian                         Veterinarian?
  protector                            Protector?
  postAdoptions                        Adoption[]                     @relation("AdoptionRegistrant")
  lostAnimals                          LostAnimal[]
  foundAnimals                         FoundAnimal[]
  exports                              ExportLog[]                    @relation("ExportActor")
  importJobsRequested                  ImportJob[]                    @relation("ImportRequester")
  importJobsApproved                   ImportJob[]                    @relation("ImportApprover")
  follows                              Follow[]                       @relation("Follower")
  followers                            Follow[]                       @relation("Followee")
  messages                             DirectMessage[]                @relation("MessageSender")
  messagesRecv                         DirectMessage[]                @relation("MessageReceiver")
  // relacoes inversas de auditoria/verificacao (LGPD §39)
  reportNotes                          ReportNote[]
  reportSourcesVerified                ReportSource[]
  organizationsVerified                Organization[]                 @relation("OrgVerifiedBy")
  protectorsVerified                   Protector[]                    @relation("ProtectorVerifiedBy")
  contentReportsDecided                ContentReport[]
  campaignUpdates                      CampaignUpdate[]
  volunteerAppsDecided                 VolunteerApplication[]         @relation("VolunteerAppDecider")
  sourceVerifications                  SourceRegistry[]
  officialContactsVerified             OfficialContact[]
  legalDocumentsCreated                LegalDocument[]
  securityIncidents                    SecurityIncident[]
  oneTimeTokens                       OneTimeToken[]
  restrictedGuardianshipRecordsCreated RestrictedGuardianshipRecord[] @relation("RestrictionCreatedBy")
  restrictedGuardianshipRecordsUpdated RestrictedGuardianshipRecord[] @relation("RestrictionUpdatedBy")

  @@index([status])
  @@index([createdAt])
  @@index([neighborhoodId])
  @@map("users")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BANNED
  DEACTIVATED
}

model Profile {
  id                 String           @id @default(uuid(7)) @db.Uuid
  userId             String           @unique @map("user_id") @db.Uuid
  headline           String?          @db.VarChar(160)
  bio                String?          @db.Text
  interests          String[]         @default([])
  badges             String[]         @default([])
  helpedAnimals      Int              @default(0) @map("helped_animals")
  adoptedCount       Int              @default(0) @map("adopted_count")
  campaignsSupported Int              @default(0) @map("campaigns_supported")
  skills             VolunteerSkill[] @default([])
  whatsappOptIn      Boolean          @default(false) @map("whatsapp_opt_in")
  lgpdConsentAt      DateTime?        @map("lgpd_consent_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         RoleKey  @unique
  description String   @db.Text
  // Hierarquia: maior = mais privilegio. Usada em comparacoes de escalate check.
  level       Int      @default(0)
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  permissions RolePermission[]
  users       UserRole[]

  @@index([level])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique @db.VarChar(80)
  description String   @db.Text
  category    String   @db.VarChar(40)
  // flag de risco: acoes sensiveis exigem 2FA + auditoria reforcada (§43, §49)
  sensitive   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  grantedAt DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedBy String?   @map("granted_by") @db.Uuid
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  // hash do refresh token (nunca o token em claro)
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(128)
  userAgent        String?   @map("user_agent") @db.VarChar(400)
  ip               String?   @db.Inet
  deviceLabel      String?   @map("device_label") @db.VarChar(120)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason    String?   @map("revoked_reason") @db.VarChar(200)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

// ============================================================================
// GEOGRAFIA
// ============================================================================

model Neighborhood {
  id         String   @id @default(uuid(7)) @db.Uuid
  slug       String   @unique @db.VarChar(80)
  name       String   @db.VarChar(120)
  region     String?  @db.VarChar(80)
  // centroide aproximado do bairro (nao e endereco)
  centerLat  Float?   @map("center_lat")
  centerLng  Float?   @map("center_lng")
  population Int?
  ibgeCode   String?  @map("ibge_code") @db.VarChar(12)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  reports                Report[]
  lostAnimals            LostAnimal[]
  foundAnimals           FoundAnimal[]
  users                  User[]
  animals                Animal[]
  organizations          Organization[]
  volunteerOpportunities VolunteerOpportunity[]
  locations              Location[]

  @@index([region])
  @@map("neighborhoods")
}

model Location {
  id              String         @id @default(uuid(7)) @db.Uuid
  name            String?        @db.VarChar(160)
  type            LocationType
  addressLine     String?        @map("address_line") @db.VarChar(240) // dado SENSIVEL
  reference       String?        @db.VarChar(240) // ponto de referencia legivel
  neighborhoodId  String?        @map("neighborhood_id") @db.Uuid
  lat             Float
  lng             Float
  // versao com jitter aplicado para exibicao publica (§12)
  publicLat       Float?         @map("public_lat")
  publicLng       Float?         @map("public_lng")
  publicPrecision PrecisionLevel @default(AGREGADA) @map("public_precision")
  isPublic        Boolean        @default(false)
  sourceUrl       String?        @map("source_url") @db.VarChar(600)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  neighborhood     Neighborhood?  @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)
  reports          Report[]
  animals          Animal[]
  organizations    Organization[]
  clinics          Clinic[]
  events           Event[]
  foundAnimalsHeld FoundAnimal[]

  campaigns Campaign[]

  @@index([neighborhoodId])
  @@index([lat, lng])
  @@index([isPublic])
  @@map("locations")
}

enum LocationType {
  DENUNCIA
  RESGATE
  LAR_TEMPORARIO
  ONG
  CLINICA
  HOSPITAL_VETERINARIO
  POSTO_VETERINARIO_MOVEL
  EVENTO
  CAMPANHA
  CASTRACAO
  VACINACAO
  APOIO
  OUTRO
}

// ============================================================================
// DENUNCIAS — nucleo do sistema (§7-§13, §86-§88)
// ============================================================================

model Report {
  id       String @id @default(uuid(7)) @db.Uuid
  // Protocolo publico: LPA-ANO-NNNNNN (§7)
  protocol String @unique @db.VarChar(20)
  year     Int
  sequence Int

  category             ReportCategory
  status               ReportStatus   @default(RECEBIDA)
  urgency              Urgency        @default(MODERADA)
  // Urgencia sugerida pelo motor (§8) — NUNCA decide sozinha
  suggestedUrgency     Urgency?       @map("suggested_urgency")
  urgencyScore         Float          @default(0) @map("urgency_score")
  urgencyFactors       Json?          @map("urgency_factors") // {factor: pontos, evidencia: "..."}
  urgencyDecidedBy     String?        @map("urgency_decided_by") @db.Uuid
  urgencyDecidedAt     DateTime?      @map("urgency_decided_at") @db.Timestamptz(6)
  urgencyJustification String?        @map("urgency_justification") @db.Text

  description  String    @db.Text
  species      Species?
  animalCount  Int       @default(1) @map("animal_count")
  occurredAt   DateTime? @map("occurred_at") @db.Timestamptz(6)
  occurredTime String?   @map("occurred_time") @db.VarChar(5)

  neighborhoodId  String?        @map("neighborhood_id") @db.Uuid
  locationId      String?        @map("location_id") @db.Uuid
  // coordenada exata: visivel apenas para operador autorizado (§12)
  exactLat        Float?         @map("exact_lat")
  exactLng        Float?         @map("exact_lng")
  // versao deslocada para exibicao publica
  publicLat       Float?         @map("public_lat")
  publicLng       Float?         @map("public_lng")
  publicPrecision PrecisionLevel @default(AGREGADA) @map("public_precision")
  isPublic        Boolean        @default(false) @map("is_public")

  authorId     String? @map("author_id") @db.Uuid
  authorName   String? @map("author_name") @db.VarChar(160) // backup p/ anonimos
  authorEmail  String? @map("author_email") @db.Citext
  authorPhone  String? @map("author_phone") @db.VarChar(20)
  isAnonymous  Boolean @default(false) @map("is_anonymous")
  witnessCount Int     @default(0) @map("witness_count")
  observations String? @db.Text

  // Encaminhamento
  forwardedTo      String?   @map("forwarded_to") @db.VarChar(200)
  forwardedAt      DateTime? @map("forwarded_at") @db.Timestamptz(6)
  externalProtocol String?   @map("external_protocol") @db.VarChar(60) // BO / MP
  externalOrg      String?   @map("external_org") @db.VarChar(160)

  // SLA (§84-§85)
  slaPolicyId     String?   @map("sla_policy_id") @db.Uuid
  dueAt           DateTime? @map("due_at") @db.Timestamptz(6)
  firstResponseAt DateTime? @map("first_response_at") @db.Timestamptz(6)
  closedAt        DateTime? @map("closed_at") @db.Timestamptz(6)
  outcome         String?   @db.Text
  outcomeCode     String?   @map("outcome_code") @db.VarChar(40)

  // Recorrencia / duplicidade (§86-§87)
  recurrenceKey      String? @map("recurrence_key") @db.VarChar(120)
  duplicateOfId      String? @map("duplicate_of_id") @db.Uuid
  duplicateConfirmed Boolean @default(false) @map("duplicate_confirmed")
  occurrencesCount   Int     @default(1) @map("occurrences_count")

  // Publicacao publica
  publicSummary String?   @map("public_summary") @db.Text
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  publishedBy   String?   @map("published_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  neighborhood Neighborhood? @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)
  location     Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  author       User?         @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  slaPolicy    SlaPolicy?    @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)

  statusHistory    ReportStatusHistory[]
  evidence         ReportEvidence[]
  assignments      ReportAssignment[]
  notes            ReportNote[]
  sources          ReportSource[]
  attachments      Attachment[]
  animals          ReportAnimal[]
  duplicateOf      Report?               @relation("ReportDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  posts            Post[]
  tickets          Ticket[]
  duplicates       Report[]              @relation("ReportDuplicates")
  internalComments Comment[]

  @@unique([year, sequence])
  @@index([status, urgency])
  @@index([category])
  @@index([neighborhoodId])
  @@index([authorId])
  @@index([createdAt(sort: Desc)])
  @@index([dueAt])
  @@index([recurrenceKey])
  @@index([isPublic, publishedAt])
  @@index([publicLat, publicLng])
  @@map("reports")
}

model ReportStatusHistory {
  id            String        @id @default(uuid(7)) @db.Uuid
  reportId      String        @map("report_id") @db.Uuid
  fromStatus    ReportStatus? @map("from_status")
  toStatus      ReportStatus  @map("to_status")
  changedById   String?       @map("changed_by") @db.Uuid
  changedByName String?       @map("changed_by_name") @db.VarChar(160)
  justification String?       @db.Text
  internalOnly  Boolean       @default(false) @map("internal_only")
  ip            String?       @db.Inet
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
  @@map("report_status_history")
}

model ReportAssignment {
