  closedAt     DateTime? @map("closed_at") @db.Timestamptz(6)
  active       Boolean   @default(true)

  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  operator User?  @relation("AssignmentOperator", fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([reportId, active])
  @@index([operatorId, active])
  @@map("report_assignments")
}

model ReportNote {
  id           String   @id @default(uuid(7)) @db.Uuid
  reportId     String   @map("report_id") @db.Uuid
  authorId     String   @map("author_id") @db.Uuid
  body         String   @db.Text
  internalOnly Boolean  @default(true) @map("internal_only")
  mentionsData Boolean  @default(false) @map("mentions_data")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
  @@map("report_notes")
}

model ReportSource {
  id           String       @id @default(uuid(7)) @db.Uuid
  reportId     String       @map("report_id") @db.Uuid
  // Fonte OBRIGATORIA para qualquer caso real publicado (§13, §79, §80)
