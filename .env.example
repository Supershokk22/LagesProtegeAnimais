# ============================================================================
# LAGES PROTEGE ANIMAIS — VARIAVEIS DE AMBIAMENTO
# Copie para .env.local (dev) e configure no painel do host (producao).
# NUNCA commite .env* com valores reais. (§117)
# ============================================================================

# --- Banco de dados -------------------------------------------------------
# PostgreSQL 14+. Requer extensao citext (criada automaticamente na migration).
DATABASE_URL="postgresql://usuario:senha@host:5432/lpa?schema=public&connection_limit=10&pool_timeout=20"
DIRECT_URL="postgresql://usuario:senha@host:5432/lpa?schema=public"

# --- App ------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Lages Protege Animais"
NEXT_PUBLIC_MUNICIPALITY="Lages"
NEXT_PUBLIC_STATE="SC"
# IBGE 4209302 = Lages/SC (somente referencia; confirmar na fonte oficial)
NEXT_PUBLIC_IBGE_CODE="4209302"

# --- Segredos (GERAR: openssl rand -base64 48) -----------------------------
# 32 bytes+ cada. NUNCA reutilizar entre ambientes.
AUTH_SECRET=""
# Chave de cifragem do segredo TOTP (AES-256-GCM). BASE64 de 32 bytes.
TOTP_ENCRYPTION_KEY=""
# Pepper do hash de senha (bcrypt ja e salgado; pepper adiciona defesa em camadas)
PASSWORD_PEPPER=""

# --- Armazenamento de evidencias (§10, §44) --------------------------------
# PRIVATE  = fora do diretorio publico (padrao). Somente via rota autenticada.
# S3       = bucket S3-compatible privado, com URL assinada de curta duracao.
STORAGE_DRIVER="PRIVATE"
STORAGE_LOCAL_PATH="./var/evidencias"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
SIGNED_URL_TTL_SECONDS="300"

# --- Uploads (§44) ---------------------------------------------------------
MAX_UPLOAD_BYTES="26214400"      # 25 MB por arquivo
MAX_FILES_PER_REPORT="10"
ALLOWED_IMAGE_MIME="image/jpeg,image/png,image/webp,image/heic"
ALLOWED_VIDEO_MIME="video/mp4,video/quicktime"
ALLOWED_DOC_MIME="application/pdf,image/jpeg,image/png"

# --- Seguranca / rate limit (§68) -----------------------------------------
# Chave do captcha. Vazio = captcha desativado (aceitavel so em dev).
TURNSTILE_SECRET_KEY=""
TURNSTILE_SITE_KEY=""
# IP fixo do servidor => NUNCA bloquear por IP compartilhado (§67)
TRUSTED_PROXY_IPS=""

# --- E-mail (§66) ---------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="nao-responda@exemplo.gov.br"
MAIL_FROM_NAME="Lages Protege Animais"

# --- Observabilidade (§71-§72) --------------------------------------------
LOG_LEVEL="info"
SENTRY_DSN=""
NEXT_TELEMETRY_DISABLED="1"

# --- PWA / push (§63) -----------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:privacidade@exemplo.gov.br"

# --- Seeds / bootstrap (§117) ---------------------------------------------
# Usado apenas pelo prisma/seed.ts. Senha inicial do SUPER_ADMIN.
SEED_SUPERADMIN_EMAIL=""
SEED_SUPERADMIN_PASSWORD=""
# False em producao: impede recriacao de role/permission divergente.
SEED_ENFORCE_RBAC="false"